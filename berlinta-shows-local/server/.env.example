# Copy to .env and fill in. Keys stay on the server and are never sent to the browser.
PORT=3001
OPENAI_API_KEY=
GEMINI_API_KEY=
# MOCK_MODE=true

# Supabase (required for artist submissions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (EPIC 4 - required for /admin)
ADMIN_PASSWORD=

# Returning Artist token hashing (optional; set in production)
# ARTIST_TOKEN_PEPPER=your-random-secret

# Artist notification email (if not set, show stays hidden until email is sent)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Berlintina <noreply@example.com>
